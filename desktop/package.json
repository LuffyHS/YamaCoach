{
  "name": "yama-coach-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo desktop do Yama Coach para Windows",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "assets": "node build/generate-assets.js",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "gg.yamacoach.desktop",
    "productName": "Yama Coach",
    "publish": {
      "provider": "github",
      "owner": "LuffyHS",
      "repo": "YamaCoach"
    },
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "splash.html", "package.json", "assets/**"],
    "extraResources": [{ "from": ".env.production", "to": "app.env" }],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "allowElevation": false,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Yama Coach",
      "menuCategory": "Yama Coach",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "artifactName": "YamaCoach-Setup.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    }
  }
}

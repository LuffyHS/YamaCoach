{
  "name": "yama-coach-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicativo desktop do Yama Coach para Windows",
  "main": "main.cjs",
  "scripts": {
    "dev": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "gg.yamacoach.desktop",
    "productName": "Yama Coach",
    "directories": { "output": "release" },
    "files": ["main.cjs", "preload.cjs", "package.json"],
    "extraResources": [{ "from": ".env.production", "to": "app.env" }],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "artifactName": "YamaCoach-Setup.${ext}",
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true }
  }
}
